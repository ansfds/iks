{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.mjs": { "includeFiles": ["dist/vercel.mjs", "dist/public/index.html"] }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__path=/api/:path*" },
    { "source": "/sitemap.xml", "destination": "/api/index?__path=/sitemap.xml" },
    { "source": "/:path((?!api/).*)", "destination": "/api/index?__path=/:path*" }
  ]
}
