# Server-only. No GitHub, Vercel or session secret may use a VITE_ prefix.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Absolute session lifetime in hours: 5 to 15 minutes. No sliding renewal.
ADMIN_SESSION_HOURS=0.25

CMS_GITHUB_REPOSITORY=ansfds/iks
CMS_GITHUB_TOKEN=
# Configure separately for the trusted Preview branch and the VERIFIED production branch.
CMS_BRANCH=experiment/git-backed-cms
CMS_PRODUCTION_BRANCH=
# Leave both disabled until the exact existing project/branch is verified.
CMS_WRITES_ENABLED=NO
CMS_PRODUCTION_WRITES_APPROVED=NO
CMS_VERCEL_PROJECT_ID=
CMS_VERCEL_TEAM_ID=
CMS_VERCEL_TOKEN=

# Login challenge required on Vercel; SITE_KEY is public, SECRET_KEY stays server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

PORT=3000
# Public URL only. Keep the current official site.
VITE_SITE_URL=https://iks-pearl.vercel.app
# No DATABASE_URL is used by this application's runtime.
# SOURCE_MYSQL_DATABASE_URL is optional ONLY for the local read-only export tool.
