# Required server configuration. No VITE_ prefix: the browser uses tRPC.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated UUIDs from Supabase Authentication > Users.
SUPABASE_ADMIN_USER_IDS=

# Content is still a read-only local catalog pending the database migration.
# No GitHub/Vercel token, local admin password hash, Secret Key or service_role is needed.

PORT=3000
# Optional public canonical origin; the current site origin is already the default.
VITE_SITE_URL=
# No DATABASE_URL is used by this application's runtime.
# SOURCE_MYSQL_DATABASE_URL is optional ONLY for the local read-only export tool.
